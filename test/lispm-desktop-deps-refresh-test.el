;;; lispm-desktop-deps-refresh-test.el --- Dependency refresh tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(add-to-list 'load-path (expand-file-name "../lisp" (file-name-directory (or load-file-name buffer-file-name))))
(require 'lispm-desktop-deps)

(ert-deftest lispm-desktop-deps-refresh-reuses-current-archives ()
  (let ((lispm-desktop-deps--refreshed nil)
        (package-archives '(("test" . "https://example.org/")))
        (package-archive-contents nil)
        (count 0))
    (cl-letf (((symbol-function 'package-refresh-contents)
               (lambda ()
                 (cl-incf count)
                 (setq package-archive-contents
                       `((one ,(package-desc-create :name 'one :version '(1)))
                         (two ,(package-desc-create :name 'two :version '(2))))))))
      (lispm-desktop-deps--refresh '((one (1))))
      (lispm-desktop-deps--refresh '((two (1))))
      (should (= count 1))
      (setq package-archives '(("other" . "https://example.org/")))
      (lispm-desktop-deps--refresh '((one (1))))
      (should (= count 2))
      (setq package-archive-contents nil)
      (lispm-desktop-deps--refresh '((one (1))))
      (should (= count 3))
      (lispm-desktop-deps--refresh '((one (3))))
      (should (= count 4)))))

(ert-deftest lispm-desktop-deps-refresh-retries-failures ()
  (let ((lispm-desktop-deps--refreshed nil)
        (package-archive-contents nil)
        (count 0))
    (cl-letf (((symbol-function 'package-refresh-contents)
               (lambda ()
                 (cl-incf count)
                 (pcase count
                   (1 (error "failed"))
                   (2 (signal 'quit nil))
                   (3 (condition-case nil
                          (package--download-one-archive '("test" . "bad") "archive-contents")
                        (error nil)))
                   (_ (setq package-archive-contents
                            `((one ,(package-desc-create :name 'one :version '(1)))))))))
              ((symbol-function 'package--download-one-archive)
               (lambda (&rest _) (error "download failed"))))
      (should-error (lispm-desktop-deps--refresh '((one (1)))))
      (should (eq 'quit (condition-case nil (progn (lispm-desktop-deps--refresh '((one (1)))) 'returned)
                          (quit 'quit))))
      (lispm-desktop-deps--refresh '((one (1))))
      (should-not lispm-desktop-deps--refreshed)
      (lispm-desktop-deps--refresh '((one (1))))
      (lispm-desktop-deps--refresh '((one (1))))
      (should (= count 4))
      (should-not (advice-member-p #'lispm-desktop-deps--watch-archive
                                   'package--download-one-archive)))))

(ert-deftest lispm-desktop-deps-refresh-across-projects ()
  (let ((lispm-desktop-deps--refreshed nil)
        (package-archive-contents nil)
        (refreshes 0)
        installed)
    (cl-letf (((symbol-function 'locate-library) (lambda (file &rest _) file))
              ((symbol-function 'lispm-desktop-deps--behind) #'ignore)
              ((symbol-function 'lispm-desktop-deps--requirements)
               (lambda (file)
                 (cond ((equal file "lispm-kit.el") '((one (1))))
                       ((equal file "lispm-ui.el") '((two (1)))))))
              ((symbol-function 'package-refresh-contents)
               (lambda ()
                 (cl-incf refreshes)
                 (setq package-archive-contents
                       `((one ,(package-desc-create :name 'one :version '(1)))
                         (two ,(package-desc-create :name 'two :version '(1)))))))
              ((symbol-function 'package-install) (lambda (name) (push name installed))))
      (lispm-desktop-deps-ensure 'lispm-kit)
      (lispm-desktop-deps-ensure 'lispm-ui)
      (lispm-desktop-deps-ensure 'lispm-browser)
      (should (= 1 refreshes))
      (should (equal (nreverse installed) '(one two))))))

(ert-deftest lispm-desktop-deps-refresh-ignores-unwritten-archive ()
  (let ((lispm-desktop-deps--refreshed nil)
        (package-archive-contents nil)
        (count 0))
    (cl-letf (((symbol-function 'package-refresh-contents)
               (lambda ()
                 (cl-incf count)
                 (package--download-one-archive '("test" . "unused") "archive-contents")
                 (setq package-archive-contents
                       `((one ,(package-desc-create :name 'one :version '(1)))))))
              ((symbol-function 'package--download-one-archive) #'ignore))
      (lispm-desktop-deps--refresh '((one (1))))
      (should-not lispm-desktop-deps--refreshed)
      (lispm-desktop-deps--refresh '((one (1))))
      (should (= count 2)))))

(ert-deftest lispm-desktop-deps-refresh-real-malformed-archive ()
  (let* ((directory (make-temp-file "lispm-refresh-test-" t))
         (source (expand-file-name "source" directory))
         (package-user-dir (expand-file-name "elpa" directory))
         (package-archives `(("local" . ,source)))
         (package-check-signature nil)
         (package-archive-contents nil)
         (lispm-desktop-deps--refreshed nil))
    (unwind-protect
        (progn
          (make-directory source)
          (with-temp-file (expand-file-name "archive-contents" source)
            (insert "not-a-list"))
          (lispm-desktop-deps--refresh '((one (1))))
          (should-not lispm-desktop-deps--refreshed))
      (delete-directory directory t))))

(provide 'lispm-desktop-deps-refresh-test)
;;; lispm-desktop-deps-refresh-test.el ends here
